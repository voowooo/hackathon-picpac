{
  "name": "picpac-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PicPac API: каталог, заказы, промокоды, админка",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env src/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
