# Порт API (приложение по умолчанию ищет сервер на :4000 того же хоста, что и Metro)
PORT=4000
# Пароль входа в админку. Обязательно смените перед показом вне локальной сети.
ADMIN_PASSWORD=picpac-admin
# Необязательно: секрет подписи токенов админки. Без него выводится из пароля.
# ADMIN_SECRET=long-random-string
# Путь к файлу базы SQLite и папке с загруженными фото
DB_FILE=./data/picpac.db
UPLOADS_DIR=./data/uploads
